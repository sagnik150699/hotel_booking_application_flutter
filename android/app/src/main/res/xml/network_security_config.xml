<?xml version="1.0" encoding="utf-8"?>
<!--
  Only encrypted traffic, only trusted system certificate authorities.
  User-installed CAs are not trusted even in debug builds, which blocks
  casual traffic interception on rooted or misconfigured devices.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
